{
  "$id": "https://mapcolonies.com/vector/detiler/v1",
  "type": "object",
  "title": "vectorDetilerSchemaV1",
  "description": "Vector's Detiler schema",
  "required": ["openapiConfig", "telemetry", "server", "redis"],
  "properties": {
    "openapiConfig": {
      "type": "object",
      "description": "OpenAPI configuration",
      "default": {},
      "properties": {
        "filePath": {
          "type": "string",
          "description": "Path to the OpenAPI 3.0 spec file",
          "default": "./openapi3.yaml",
          "x-env-value": "OPENAPI_FILE_PATH"
        },
        "basePath": {
          "type": "string",
          "description": "The base path for the OpenAPI UI and raw OpenAPI spec",
          "default": "/docs"
        },
        "rawPath": {
          "type": "string",
          "description": "The path to the raw OpenAPI spec",
          "default": "/api"
        },
        "uiPath": {
          "type": "string",
          "description": "The path to the OpenAPI UI",
          "default": "/api"
        }
      },
      "unevaluatedProperties": false,
      "required": ["filePath", "basePath", "rawPath", "uiPath"]
    },
    "telemetry": {
      "type": "object",
      "description": "Telemetry configuration",
      "default": {},
      "unevaluatedProperties": false,
      "properties": {
        "serviceName": {
          "type": "string",
          "description": "The name of the service",
          "x-env-value": "TELEMETRY_SERVICE_NAME"
        },
        "hostname": {
          "type": "string",
          "description": "The hostname of the service",
          "x-env-value": "TELEMETRY_HOST_NAME"
        },
        "version": {
          "type": "string",
          "description": "The version of the service",
          "x-env-value": "TELEMETRY_SERVICE_VERSION"
        },
        "logger": {
          "$ref": "https://mapcolonies.com/common/telemetry/logger/v1"
        },
        "tracing": {
          "type": "object",
          "description": "Tracing configuration",
          "unevaluatedProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether tracing is enabled",
              "x-env-value": "TELEMETRY_TRACING_ENABLED"
            },
            "url": {
              "type": "string",
              "description": "The URL of the otlp tracing endpoint",
              "x-env-value": "TELEMETRY_TRACING_URL"
            }
          }
        },
        "metrics": {
          "type": "object",
          "description": "Metrics configuration",
          "unevaluatedProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether metrics are enabled",
              "x-env-value": "TELEMETRY_METRICS_ENABLED"
            },
            "url": {
              "type": "string",
              "description": "The URL of the otlp metrics endpoint",
              "x-env-value": "TELEMETRY_METRICS_URL"
            },
            "interval": {
              "type": "integer",
              "description": "The interval in milliseconds between metrics exports",
              "x-env-value": "TELEMETRY_METRICS_INTERVAL"
            }
          }
        }
      },
      "required": ["logger"]
    },
    "server": {
      "type": "object",
      "description": "Server configuration",
      "default": {},
      "unevaluatedProperties": false,
      "properties": {
        "port": {
          "minimum": 1,
          "maximum": 65535,
          "default": 8080,
          "description": "The port the server will listen on",
          "type": "integer",
          "x-env-value": "SERVER_PORT"
        },
        "request": {
          "type": "object",
          "default": {},
          "unevaluatedProperties": false,
          "required": ["payload"],
          "properties": {
            "payload": {
              "type": "object",
              "default": {},
              "unevaluatedProperties": false,
              "required": ["limit"],
              "properties": {
                "limit": {
                  "type": "string",
                  "default": "1mb",
                  "description": "The maximum payload size of an incoming request",
                  "x-env-value": "REQUEST_PAYLOAD_LIMIT"
                }
              }
            }
          }
        },
        "response": {
          "type": "object",
          "default": {},
          "unevaluatedProperties": false,
          "properties": {
            "compression": {
              "type": "object",
              "default": {},
              "unevaluatedProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to compress response bodies for all requests that traverse through the middleware",
                  "x-env-value": "RESPONSE_COMPRESSION_ENABLED"
                },
                "options": {
                  "type": ["null", "object"],
                  "default": null,
                  "description": "Options for the compression middleware"
                }
              }
            }
          }
        }
      },
      "required": ["port", "request", "response"]
    },
    "redis": {
      "type": "object",
      "description": "Redis configuration",
      "default": {},
      "unevaluatedProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "The host of the redis database",
          "default": "localhost",
          "x-env-value": "REDIS_HOST"
        },
        "port": {
          "type": "integer",
          "description": "The port of the redis database",
          "default": 6379,
          "x-env-value": "REDIS_PORT"
        },
        "username": {
          "type": "string",
          "description": "The username of the redis database",
          "x-env-value": "REDIS_USERNAME"
        },
        "password": {
          "type": "string",
          "description": "The password of the redis database",
          "x-env-value": "REDIS_PASSWORD"
        },
        "enableSslAuth": {
          "type": "boolean",
          "description": "Whether to enable SSL authentication",
          "default": false,
          "x-env-value": "REDIS_ENABLE_SSL_AUTH"
        },
        "sslPaths": {
          "type": "object",
          "description": "Paths to the SSL certificate files",
          "default": {},
          "unevaluatedProperties": false,
          "properties": {
            "ca": {
              "type": "string",
              "description": "The path to the ca file",
              "default": "",
              "x-env-value": "REDIS_CA_PATH"
            },
            "key": {
              "type": "string",
              "description": "The path to the key file",
              "default": "",
              "x-env-value": "REDIS_KEY_PATH"
            },
            "cert": {
              "type": "string",
              "description": "The path to the cert file",
              "default": "",
              "x-env-value": "REDIS_CERT_PATH"
            }
          },
          "required": ["ca", "key", "cert"]
        },
        "database": {
          "type": "integer",
          "description": "The index of the redis database",
          "default": 0,
          "x-env-value": "REDIS_DATABASE"
        },
        "keyPrefix": {
          "type": "string",
          "description": "Prefix to be used as part of every redis key",
          "default": "",
          "x-env-value": "REDIS_KEY_PREFIX"
        }
      },
      "required": ["host", "port", "enableSslAuth", "sslPaths", "keyPrefix"]
    }
  }
}
