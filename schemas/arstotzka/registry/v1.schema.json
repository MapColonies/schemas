{
  "$id": "https://mapcolonies.com/arstotzka/registry/v1",
  "type": "object",
  "title": "arstotzkaRegistryV1",
  "description": "Arstotzka's registry service schema",
  "allOf": [
    { "$ref": "https://mapcolonies.com/common/boilerplate/v4" },
    {
      "type": "object",
      "required": ["telemetry", "db", "app", "mediator"],
      "properties": {
        "telemetry": { "type": "object", "required": ["metrics"] },
        "db": { "$ref": "#/definitions/db" },
        "app": { "$ref": "#/definitions/app" },
        "mediator": { "$ref": "#/definitions/mediator" }
      }
    }
  ],
  "definitions": {
    "db": {
      "allOf": [
        { "$ref": "https://mapcolonies.com/common/db/partial/v2" },
        {
          "type": "object",
          "required": ["database"],
          "properties": {
            "type": { "type": "string", "description": "TypeORM driver type", "default": "postgres", "x-env-value": "DB_TYPE" },
            "schema": { "type": "string", "description": "The schema name of the database", "default": "registry", "x-env-value": "DB_SCHEMA" },
            "database": { "type": "string", "description": "The database name", "maxLength": 63, "default": "postgres", "x-env-value": "DB_NAME" }
          }
        }
      ]
    },
    "app": {
      "type": "object",
      "required": ["rotationLockExpiration", "serviceToActionsUrlMap"],
      "properties": {
        "rotationLockExpiration": { "type": "integer", "default": 60000, "x-env-value": "APP_ROTATION_LOCK_EXPIRATION" },
        "serviceToActionsUrlMap": {
          "type": "object",
          "default": {},
          "properties": { "ingestion": { "type": "string", "x-env-value": "APP_INGESTION_ACTIONS_URL" } }
        }
      }
    },
    "mediator": {
      "type": "object",
      "required": ["timeout", "enableRetryStrategy", "retryStrategy"],
      "properties": {
        "actiony": { "type": "object", "properties": { "url": { "type": "string", "x-env-value": "MEDIATOR_ACTIONY_URL" } } },
        "locky": { "type": "object", "properties": { "url": { "type": "string", "x-env-value": "MEDIATOR_LOCKY_URL" } } },
        "timeout": { "type": "integer", "default": 10000, "x-env-value": "MEDIATOR_TIMEOUT" },
        "enableRetryStrategy": { "type": "boolean", "default": false, "x-env-value": "MEDIATOR_ENABLE_RETRY_STRATEGY" },
        "retryStrategy": {
          "type": "object",
          "default": {},
          "properties": {
            "retries": { "type": "integer", "x-env-value": "MEDIATOR_RETRY_STRATEGY_RETRIES" },
            "shouldResetTimeout": { "type": "boolean", "x-env-value": "MEDIATOR_RETRY_STRATEGY_SHOULD_RESET_TIMEOUT" },
            "isExponential": { "type": "boolean", "x-env-value": "MEDIATOR_RETRY_STRATEGY_IS_EXPONENTIAL" },
            "delay": { "type": "integer", "x-env-value": "MEDIATOR_RETRY_STRATEGY_DELAY" }
          }
        }
      }
    }
  }
}
